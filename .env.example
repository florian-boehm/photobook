# Photobook Configuration
# Copy this file to .env and modify as needed

# Application settings
APP_NAME=Photobook
APP_VERSION=0.1.0
DEBUG=True

# Server settings
HOST=0.0.0.0
PORT=8000

# Media directory settings
# This is the root directory containing all media files
# Files will be served from subdirectories within this path
MEDIA_ROOT_PATH=/media

# Mapping file settings
# This JSON file maps album names and file IDs to file paths
MAPPING_FILE_PATH=/data/mapping.json

# Streaming settings
CHUNK_SIZE=8192
MAX_CHUNK_SIZE=1048576

# CORS settings
CORS_ORIGINS=*
